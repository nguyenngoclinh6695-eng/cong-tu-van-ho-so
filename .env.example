# Sao chép file này thành .env.local rồi điền giá trị thật khi bắt đầu nối backend (Tuần 3+).
# Ở bản UI hiện tại (Tuần 1), toàn bộ dữ liệu là mock — chưa cần các biến này để chạy `npm run dev`.

# Supabase (Tuần 3: database + auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — lưu hội thoại chatbot (chỉ server dùng, KHÔNG thêm NEXT_PUBLIC_, không
# được lộ xuống trình duyệt). Lấy SUPABASE_SECRET_KEY trong Supabase Dashboard >
# Project Settings > API Keys > secret key (sb_secret_...).
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# URL công khai của site, dùng cho magic link đăng nhập (Tuần 6) và metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000
